{
  "name": "focar-site-public",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@focar/site",
    "build": "npm run build --workspace=@focar/site",
    "start": "npm run start --workspace=@focar/site",
    "lint": "npm run lint --workspace=@focar/site",
    "typecheck": "npm run typecheck --workspace=@focar/site"
  }
}
